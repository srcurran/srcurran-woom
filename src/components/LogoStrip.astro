---
/* The "as seen in" strip — the logos as marks on the page itself, between the
   deck and the contact closer, rather than inside a deck card. A label and one
   centred, wrapping row of logos; no frame, no fill. Data lives in ../data/logos. */
import { logos } from "../data/site";
---

<section class="logo-strip" aria-labelledby="logo-strip-label">
  <div class="logo-strip__inner">
    <h2 class="eyebrow logo-strip__label" id="logo-strip-label">Where I've worked</h2>
    <ul class="logo-strip__marks">
      {logos.map((logo) => (
        <li class="logo-strip__item" style={`--mark-w: ${logo.w}`}>
          <img class="logo-strip__mark" src={logo.src} alt={logo.alt} loading="lazy" />
        </li>
      ))}
    </ul>
  </div>
</section>
