---
import { logos } from "../data/site";

const COPIES = 4;
const loop = Array.from({ length: COPIES }, () => logos).flat();
---

<section
  class="logo-strip"
  aria-label="Where I've worked"
  style={`--logo-count: ${logos.length}; --logo-strip-copies: ${COPIES}`}
>
  <div class="logo-strip__inner">
    <ul class="logo-strip__marks">
      {loop.map((logo, i) => (
        <li
          class="logo-strip__item"
          style={logo.h ? `--mark-h: ${logo.h}` : undefined}
          aria-hidden={i >= logos.length ? "true" : undefined}
          data-logo={logo.alt}
        >

          <img class="logo-strip__mark" src={logo.src} alt={logo.alt} />
        </li>
      ))}
    </ul>
  </div>
</section>
