---
/* One deck card. This shell owns the shared contract every kind needs — the
   .deck__slide wrapper + .deck__card article with the data-* hooks deck.ts reads
   (data-card / data-index / data-section) and the theme class — then dispatches the
   body to a per-kind component in ./cards. */
import type { Slide } from "../data/slides";
import BioCard from "./cards/BioCard.astro";
import IntroCard from "./cards/IntroCard.astro";
import MockupCard from "./cards/MockupCard.astro";
import LogosCard from "./cards/LogosCard.astro";
import ResultsCard from "./cards/ResultsCard.astro";

interface Props {
  slide: Slide;
  index: number;
  /** Home (index) deck — surfaces the project name in the mockup chin. */
  home?: boolean;
}

const { slide, index, home = false } = Astro.props;
const theme = slide.theme ?? "light";
// The per-slide background paints the card fill for every kind EXCEPT mockup, where
// it lives on the image frame instead (so the white notch/chin stay white).
const cardBackground =
  slide.background && slide.kind !== "mockup" ? `background: ${slide.background}` : undefined;
---

<div class:list={["deck__slide", `deck__slide--${slide.kind}`]}>
  <article
    class:list={["deck__card", "slide", `slide--${slide.kind}`, `slide--${theme}`]}
    style={cardBackground}
    data-card
    data-index={index}
    data-section={slide.section}
    data-card-title={slide.section ?? slide.kind}
  >
    {slide.kind === "bio" && <BioCard slide={slide} />}
    {slide.kind === "intro" && <IntroCard slide={slide} />}
    {slide.kind === "mockup" && <MockupCard slide={slide} home={home} />}
    {slide.kind === "logos" && <LogosCard />}
    {slide.kind === "results" && <ResultsCard slide={slide} />}
  </article>
</div>
