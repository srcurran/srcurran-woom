---
import { logoWall, type Slide } from "../data/site";

interface Props {
  slide: Slide;
  index: number;
}

const { slide, index } = Astro.props;
const theme = slide.theme ?? "light";
const media = slide.media?.[0];

/** __phrase__ → underlined emphasis (not a link). */
function emphasize(text: string): string {
  return text.replace(/__([^_]+)__/g, '<u class="slide__em">$1</u>');
}
---

<article
  class:list={["deck__card", "slide", `slide--${slide.kind}`, `slide--${theme}`]}
  style={slide.background ? `background: ${slide.background}` : undefined}
  data-card
  data-index={index}
  data-section={slide.section}
>
  {
    slide.kind === "bio" && (
      <div class="slide__inner">
        <h2 class="slide__heading">{slide.heading}</h2>
        <div class="slide__prose">
          {slide.paragraphs?.map((p) => <p set:html={emphasize(p)} />)}
        </div>
      </div>
    )
  }

  {
    slide.kind === "intro" && (
      <div class:list={["slide__inner", "slide__inner--intro", !media && "is-text-only"]}>
        <div class="slide__text">
          <h2 class="slide__heading">{slide.heading}</h2>
          <div class="slide__prose">
            {slide.paragraphs?.map((p) => <p set:html={emphasize(p)} />)}
          </div>
        </div>
        {slide.meta && slide.meta.length > 0 && (
          <dl class="slide__meta">
            {slide.meta.map((row) => (
              <div class="slide__meta-row">
                <dt class="slide__meta-label">{row.label}</dt>
                <dd class="slide__meta-value">{row.value}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>
    )
  }

  {
    slide.kind === "mockup" &&
      media &&
      ((slide.media?.length ?? 0) > 1 || slide.fit === "contain" ? (
        /* Multiple assets (or a single one forced to contain, e.g. a device on
           its own slide) → padded, gapped layout that fills the card but lets the
           assets breathe. Aperture counter-scales it through the zoom. */
        <div class="slide__aperture" data-aperture>
          <div
            class:list={["slide__shots", `count-${slide.media?.length}`]}
            data-parallax
          >
            {(slide.media ?? []).map((m) => (
              <figure class="slide__shot">
                {m.phoneFrame ? (
                  <div class="phone">
                    {m.type === "video" ? (
                      <video src={m.src} autoplay muted loop playsinline class="phone__screen" />
                    ) : (
                      <img src={m.src} alt={m.alt ?? ""} class="phone__screen" />
                    )}
                    <img class="phone__frame" src="/work/phone-mask.png" alt="" aria-hidden="true" />
                  </div>
                ) : m.type === "video" ? (
                  <video
                    src={m.src}
                    autoplay
                    muted
                    loop
                    playsinline
                    class:list={[m.phoneBorder && "isPhoneBorder", m.rounded && "isRounded"]}
                  />
                ) : (
                  <img src={m.src} alt={m.alt ?? ""} class:list={[m.rounded && "isRounded"]} />
                )}
              </figure>
            ))}
          </div>
        </div>
      ) : (
        /* Single asset → fills the whole card (cover), pinned centre or top.
           data-aperture: counter-scaled through the zoom so the card frame opens
           to reveal the full-size content (aperture effect), like the multi case. */
        <div
          class:list={["slide__cover", `pin-${slide.pin ?? "center"}`]}
          data-aperture
        >
          {media.type === "video" ? (
            <video src={media.src} autoplay muted loop playsinline />
          ) : (
            <img src={media.src} alt={media.alt ?? ""} />
          )}
        </div>
      ))
  }

  {
    slide.kind === "logos" && (
      /* The logo wall — individual marks, not a flattened image. Aperture
         counter-scales it through the zoom like the shot layouts above. */
      <div class="slide__aperture" data-aperture>
        <div class="logo-wall" data-parallax>
          {logoWall.map((row) => (
            <div class="logo-wall__row" style={`gap: ${row.gap}cqw`}>
              {row.marks.map((mark) => (
                <img
                  class="logo-wall__mark"
                  src={mark.src}
                  alt={mark.alt}
                  style={`width: ${mark.w}cqw`}
                  loading="lazy"
                />
              ))}
            </div>
          ))}
        </div>
      </div>
    )
  }

  {
    slide.kind === "results" && (
      <div class="slide__inner">
        <h2 class="slide__heading">{slide.heading}</h2>
        <ul class="slide__results">
          {slide.items?.map((item) => <li set:html={emphasize(item)} />)}
        </ul>
      </div>
    )
  }
</article>
