---
import { about } from "../data/site";

interface Props {
  /** /work rather than / — greets with "Hello" instead of "Hi". */
  full?: boolean;
}
const { full = false } = Astro.props;
const heading = full ? about.headingFull : about.heading;
---

<section class="hero" data-hero id="about">
  <div class="hero__inner">
    <div class="hero__content">
      <h1 class="hero__headline">{heading}</h1>
      <div class="hero__bio">
        {about.paragraphs.map((p) => <p>{p}</p>)}
        {about.notes.map((p) => <p class="body-sm">{p}</p>)}
        <p class="body-sm hero__projects">
          <span class="hero__projects-lead">{about.sideProjectsLead}</span>
          {
            about.sideProjects.map((project) => (
              <a class="hero__project-link" href={project.href} target="_blank" rel="noopener noreferrer">
                {project.label}
              </a>
            ))
          }
        </p>
      </div>
    </div>
  </div>
</section>
