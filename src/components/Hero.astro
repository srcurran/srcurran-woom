---
import { about } from "../data/site";

interface Props {
  /** /work rather than / — greets with "Hello" instead of "Hi". The two routes
   *  are otherwise the same page; this is where they're free to drift. */
  full?: boolean;
}

const { full = false } = Astro.props;
const heading = full ? about.headingFull : about.heading;
---

<section class="hero" data-hero id="about">
  <div class="hero__inner">
    <div class="hero__content">
      <h1 class="hero__headline">{heading}</h1>
      <div class="hero__bio">
        {about.paragraphs.map((p) => <p>{p}</p>)}
        {about.notes.map((p) => <p class="body-sm">{p}</p>)}
      </div>
    </div>
  </div>
</section>
