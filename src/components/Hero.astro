---
import { about } from "../data/site";
import { greet } from "../lib/visitor-name";

interface Props {
  /** /work rather than / — greets with "Hello" instead of "Hi". */
  full?: boolean;
  /** Visitor's name from the URL — greets them by it instead of the default. */
  name?: string;
}
const { full = false, name } = Astro.props;
const heading = name ? greet(name) : full ? about.headingFull : about.heading;
const paragraphs = name
  ? about.paragraphs.map((p, i) => (i === 0 ? `${about.leadNamed} ${p}` : p))
  : about.paragraphs;
---

<section class="hero" data-hero data-hero-named={name ? "" : undefined} id="about">
  <div class="hero__inner">
    <div class="hero__content">
      <h1 class:list={["hero__headline", { "hero__headline--named": name }]}>
        {heading}
      </h1>
      <div class="hero__bio">
        {paragraphs.map((p) => <p>{p}</p>)}
        {
          about.notes.map((note) => (
            <p class="body-sm">
              {note.map((segment) =>
                segment.href ? (
                  <a class="hero__link" href={segment.href} target="_blank" rel="noopener noreferrer">
                    {segment.text}
                  </a>
                ) : (
                  segment.text
                ),
              )}
            </p>
          ))
        }
      </div>
    </div>
  </div>
</section>
