---
import { about } from "../data/site";

interface Props {
  /** /work rather than / — greets with "Hello" instead of "Hi". */
  full?: boolean;
}
const { full = false } = Astro.props;
const heading = full ? about.headingFull : about.heading;
---

<section class="hero" data-hero id="about">
  <div class="hero__inner">
    <div class="hero__content">
      <h1 class="hero__headline">{heading}</h1>
      <div class="hero__bio">
        {about.paragraphs.map((p) => <p>{p}</p>)}
        {
          about.notes.map((note) => (
            <p class="body-sm">
              {note.map((segment) =>
                segment.href ? (
                  <a class="hero__link" href={segment.href} target="_blank" rel="noopener noreferrer">
                    {segment.text}
                  </a>
                ) : (
                  segment.text
                ),
              )}
            </p>
          ))
        }
      </div>
    </div>
  </div>
</section>
