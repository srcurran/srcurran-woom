---
import { about } from "../data/site";
import { greeting } from "../lib/visitor-name";

interface Props {
  /** /work rather than / — greets with "Hello" instead of "Hi". */
  full?: boolean;
  /** Visitor's name from the URL — greets them by it instead of the default. */
  name?: string;
}
const { full = false, name } = Astro.props;
const heading = full ? about.headingFull : about.heading;
const [greetBefore, greetAfter] = greeting();
const paragraphs = name
  ? about.paragraphs.map((p, i) => (i === 0 ? `${about.leadNamed} ${p}` : p))
  : about.paragraphs;
---

<section class="hero" data-hero data-hero-named={name} id="about">
  <div class="hero__inner">
    <div class="hero__content">
      {
        name ? (
          <h1 class="hero__headline">
            {greetBefore}<span class="hero__name" data-name-shader><span class="hero__name-text">{name}</span><canvas aria-hidden="true" /></span>{greetAfter}
          </h1>
        ) : (
          <h1 class="hero__headline">{heading}</h1>
        )
      }
      <div class="hero__bio">
        {paragraphs.map((p) => <p>{p}</p>)}
        {
          about.notes.map((note) => (
            <p class="body-sm">
              {note.map((segment) =>
                segment.href ? (
                  <a class="hero__link" href={segment.href} target="_blank" rel="noopener noreferrer">
                    {segment.text}
                  </a>
                ) : (
                  segment.text
                ),
              )}
            </p>
          ))
        }
      </div>
    </div>
  </div>
</section>
