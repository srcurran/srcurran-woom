---
import { site } from "../data/site";
---

<header class="site-header">
  <div class="page site-header__inner flex row">
    <a class="brand flex row" href="/" aria-label={site.name}>
      <span class="brand__name">{site.name}</span>
      <span class="brand__role body-sm">{site.role}</span>
    </a>

    <nav aria-label="Contact">
      <a class="header-link" href={`mailto:${site.email}`}>Contact</a>
    </nav>
  </div>
</header>
