---
import type { Slide } from "../../data/slides";
import { emphasize } from "../../lib/emphasize";

interface Props {
  slide: Slide;
}
const { slide } = Astro.props;
const stars = slide.media?.[0];
---

<div class="slide__inner slide__inner--quote">
  <div class="slide__quote">
    <div class="slide__quote-head">
      {stars && <img class="slide__quote-stars" src={stars.src} alt={stars.alt ?? ""} />}
      {slide.attribution && <p class="slide__quote-attribution">{slide.attribution}</p>}
    </div>
    <blockquote class="slide__quote-text">
      {slide.paragraphs?.map((p) => <p set:html={emphasize(p)} />)}
    </blockquote>
  </div>
</div>
