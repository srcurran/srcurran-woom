---
import Card from "./Card.astro";
import { slides } from "../data/site";

const shown = slides.filter((s) => !s.indexOnly);
---

<section class="deck" data-deck aria-label="Selected work">
  <div class="deck__viewport" data-deck-viewport>
    {shown.map((slide, i) => <Card slide={slide} index={i} />)}
  </div>
</section>
