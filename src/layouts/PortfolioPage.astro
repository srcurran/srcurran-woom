---
import Layout from "./Layout.astro";
import TopNav from "../components/TopNav.astro";
import SideNav from "../components/SideNav.astro";
import Hero from "../components/Hero.astro";
import Deck from "../components/Deck.astro";
import LogoStrip from "../components/LogoStrip.astro";
import Contact from "../components/Contact.astro";

interface Props {
  title: string;
  /** Greet with "Hello" instead of "Hi" — /work's longer opening. */
  full?: boolean;
}
const { title, full = false } = Astro.props;
---

<Layout title={title}>
  <TopNav />
  <SideNav />

  <main>
    <div class="opening">
      <Hero full={full} />
      <LogoStrip />
    </div>
    <Deck />
    <Contact />
  </main>
</Layout>
