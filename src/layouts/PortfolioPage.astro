---
import Layout from "./Layout.astro";
import TopNav from "../components/TopNav.astro";
import SideNav from "../components/SideNav.astro";
import Hero from "../components/Hero.astro";
import Deck from "../components/Deck.astro";
import LogoStrip from "../components/LogoStrip.astro";
import Contact from "../components/Contact.astro";

interface Props {
  title: string;
  /** Greet with "Hello" instead of "Hi" — /work's longer opening. */
  full?: boolean;
  /** Visitor's name from the URL, so /Foo says "Hey Foo!" */
  name?: string;
  /** Break the deck's sections with company names instead of title and results cards. */
  sectionBreaks?: boolean;
}
const { title, full = false, name, sectionBreaks = false } = Astro.props;
---

<Layout title={title}>
  <TopNav />
  <SideNav />

  <main>
    <div class="opening">
      <Hero full={full} name={name} />
      <LogoStrip />
    </div>
    <Deck sectionBreaks={sectionBreaks} />
    <Contact />
  </main>
</Layout>
