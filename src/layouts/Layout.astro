---
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} — ${site.role}`,
  description = `Portfolio of ${site.name}, ${site.role}.`,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    {/* Type system from the Figma: Poppins (display) + Merriweather (serif body). */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Merriweather:wght@300;400&family=Poppins:wght@600;700&display=swap"
      rel="stylesheet"
    />
    {/* Flag JS as available before paint so reveal elements hide without a flash.
        `play-intro` is added only on the first load of a browser session (a new
        hard visit); the CSS guard (deck.css) hides the intro targets ONLY under it.
        Reloads, HMR rebuilds, and reloading while scrolled all skip it — so the
        title card never gets hidden and re-popped-in late. sessionStorage survives
        reloads within a tab but resets when the tab/session ends. */}
    <script is:inline>
      document.documentElement.classList.add("js");
      // Own scroll restoration: the deck deep-links to the hash's section on load
      // (deck.ts). Left on the browser's default `auto`, that native restore races
      // the deep-link and both get clobbered to the top — landing on the first card
      // in its off-screen peek/enter state. `manual` makes the deep-link the sole
      // authority, so reloads land the section centred.
      if ("scrollRestoration" in history) history.scrollRestoration = "manual";
      try {
        if (!sessionStorage.getItem("intro-seen")) {
          document.documentElement.classList.add("play-intro");
          sessionStorage.setItem("intro-seen", "1");
        }
      } catch (_) {
        document.documentElement.classList.add("play-intro");
      }
    </script>

    {/* Clarity — session replay + heatmaps. No consent signal is sent, which is
        deliberate: without one Clarity restricts itself in the EEA, UK, and
        Switzerland (page views still count, but sessions fragment per-page and
        replay is off), so visitors from those regions simply aren't recorded and
        the site needs no cookie banner. Recordings roll off after 30 days. */}
    <script is:inline>
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script", "y0umn1yiav");
    </script>

    <script
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="c8d029e1-295b-4f7c-bd3e-d93bb0608e14"></script>
  </head>
  <body>
    <slot />

    <script>
      import "../scripts/main";
    </script>
  </body>
</html>
