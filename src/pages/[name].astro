---
import PortfolioPage from "../layouts/PortfolioPage.astro";
import { greet, visitorName } from "../lib/visitor-name";
import { site } from "../data/meta";

export const prerender = false;

const name = visitorName(Astro.params.name);
if (!name) return Astro.redirect("/");
---

<PortfolioPage title={`${greet(name)} — ${site.name}`} name={name} results />
