#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/seancurran/dev/woom-two/node_modules/am-i-vibing/dist/node_modules:/Users/seancurran/dev/woom-two/node_modules/am-i-vibing/node_modules:/Users/seancurran/dev/woom-two/node_modules:/Users/seancurran/dev/node_modules:/Users/seancurran/node_modules:/Users/node_modules:/node_modules:/Users/seancurran/dev/woom-two/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/seancurran/dev/woom-two/node_modules/am-i-vibing/dist/node_modules:/Users/seancurran/dev/woom-two/node_modules/am-i-vibing/node_modules:/Users/seancurran/dev/woom-two/node_modules:/Users/seancurran/dev/node_modules:/Users/seancurran/node_modules:/Users/node_modules:/node_modules:/Users/seancurran/dev/woom-two/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../am-i-vibing/dist/cli.mjs" "$@"
else
  exec node  "$basedir/../am-i-vibing/dist/cli.mjs" "$@"
fi
